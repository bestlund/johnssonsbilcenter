# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# Public site URL (absoluta länkar, OG, canonical, sitemap, robots).
# Prod: https://www.johnssonsbilcenter.se — sätt detta i Vercel. Lokalt: localhost.
# Faller tillbaka till prod-www om osatt (se lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://www.johnssonsbilcenter.se

# Nextlease embed — publiceringskonfig-UID för sajten (inte hemlig)
NEXT_PUBLIC_NEXTLEASE_UID=1fb18af2-7317-4074-811d-e3eef824a073

# Google Places API (New) — SERVER-ONLY (inget NEXT_PUBLIC_). Skapa nyckel i
# Google Cloud, begränsa till Places API. Place ID:t är inte hemligt.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ID=ChIJT3F6RsslUkYRQ9aWTcPTrB0

# Leads (M2) — SERVER-ONLY. Formulär skickar strukturerade mejl via Resend.
# RESEND_API_KEY: skapa på resend.com. Utan verifierad domän kan Resend bara
# leverera till kontots egen e-post och avsändaren måste vara onboarding@resend.dev.
# LEAD_TILL: mottagaradress för leads. LEAD_FRAN: verifierad avsändare (eller
# onboarding@resend.dev under test).
RESEND_API_KEY=
LEAD_TILL=jv222ur@student.lnu.se
LEAD_FRAN=onboarding@resend.dev
